# Committed `.env` holds production-oriented defaults. For laptop dev, use `.env.local` — see `.env.local.example`.

# ─── Production (also set in Vercel → Settings → Environment Variables) ─────
# NEXT_PUBLIC_SITE_URL=https://musicjamspace.com
# NEXT_PUBLIC_API_URL=https://jamspace.corexinnovations.com

# ─── Local (`.env.local` — gitignored) ───────────────────────────────────────
# NEXT_PUBLIC_SITE_URL=http://localhost:8080
# NEXT_PUBLIC_API_URL=http://localhost:3001

# EmailJS
# NEXT_PUBLIC_EMAILJS_SERVICE_ID=
# NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
# NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
# NEXT_PUBLIC_ORDER_RECEIVER_EMAIL=you@example.com,other@example.com
